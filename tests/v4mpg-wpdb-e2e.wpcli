<?php

namespace AGSyncBridge {
	use RuntimeException;

	if ( ! class_exists( __NAMESPACE__ . '\\Config', false ) ) {
		class Config {
			private $storage;
			public function __construct( $storage ) { $this->storage = $storage; }
			public function get_storage_dir() { return $this->storage; }
			public function get_role() { return 'remote'; }
		}
	}
	if ( ! class_exists( __NAMESPACE__ . '\\Logger', false ) ) { class Logger {} }
	if ( ! class_exists( __NAMESPACE__ . '\\Remote_Operation_Runtime', false ) ) {
		class Remote_Operation_Runtime {
			public $state = array();
			public function __construct( $config = null, $logger = null ) { unset( $config, $logger ); }
			public function reserve( $kind, array $state ) { $this->state = array_merge( $state, array( 'kind'=>$kind, 'status'=>'queued', 'updated_at'=>gmdate('c') ) ); return $this->state; }
			public function claim( $id ) { $this->state['id']=$id;$this->state['status']='running';return $this->state; }
			public function heartbeat( $id, $stage, $progress, array $changes=array() ) { $this->state=array_merge($this->state,$changes,array('id'=>$id,'stage'=>$stage,'progress'=>$progress,'status'=>'running','updated_at'=>gmdate('c')));return $this->state; }
			public function finalize( $id, $status, array $changes=array() ) { $this->state=array_merge($this->state,$changes,array('id'=>$id,'status'=>$status,'updated_at'=>gmdate('c')));return $this->state; }
			public function inspect() { return $this->state; }
			public function resolve_recovery( $id, $kind, $updated, array $verification ) { unset($kind,$updated,$verification);$this->state['id']=$id;$this->state['status']='reconciled';return $this->state; }
		}
	}

	class V4MPG_E2E_WPDB {
		public $prefix;
		public $insert_id = 0;
		public $commit_fault = 'none';
		public $cas_fault = false;
		private $inner;
		public function __construct( $inner, $prefix ) { $this->inner=$inner;$this->prefix=$prefix; }
		public function prepare( $query, ...$args ) { return $this->inner->prepare( $query, ...$args ); }
		public function get_var( $query ) { return $this->inner->get_var( $query ); }
		public function get_row( $query, $output = OBJECT, $y = 0 ) { return $this->inner->get_row( $query, $output, $y ); }
		public function get_results( $query, $output = OBJECT ) { return $this->inner->get_results( $query, $output ); }
		public function get_col( $query, $x = 0 ) { return $this->inner->get_col( $query, $x ); }
		public function insert( $table, $data, $format = null ) { $result=$this->inner->insert($table,$data,$format);$this->insert_id=(int)$this->inner->insert_id;return $result; }
		public function update( $table, $data, $where, $format = null, $where_format = null ) { return $this->inner->update($table,$data,$where,$format,$where_format); }
		public function delete( $table, $where, $where_format = null ) { return $this->inner->delete($table,$where,$where_format); }
		public function query( $query ) { $normalized=strtoupper(trim((string)$query));if($this->cas_fault&&0===strpos($normalized,'UPDATE `'.strtoupper($this->prefix).'MPG_RUNTIME_DATASET_ROWS` SET ROW_DATA=')){return 0;}if('COMMIT'===$normalized&&'before'===$this->commit_fault){return false;}if('COMMIT'===$normalized&&'after'===$this->commit_fault){$result=$this->inner->query($query);return false; }return $this->inner->query($query); }
	}

	function e2e_expect( $condition, $message ) { if ( ! $condition ) { throw new RuntimeException( $message ); } }
	function e2e_digest( array $rows ) { $ctx=hash_init('sha256');foreach($rows as $row){hash_update($ctx,$row['row_index']."\0".$row['url_path']."\0".$row['row_sha256']."\n");}return hash_final($ctx); }
	function e2e_content_hash( $value ) { return hash('sha256',"v4mpg-content-v1\0text\0".$value); }
}

