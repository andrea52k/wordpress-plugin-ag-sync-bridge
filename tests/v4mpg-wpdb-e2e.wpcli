		foreach(array('before'=>'rolled-back','after'=>'deployed') as $fault=>$expected){$base=$reset();$adapter=new V4MPG_E2E_WPDB($wpdb,$test_prefix);$adapter->commit_fault=$fault;$runtime=new Remote_Operation_Runtime();$service=new V4MPG_Table_Deploy_Service(new Config($storage),new Logger(),$adapter,$runtime);$case=$make($base,'e2e-'.$fault.'-0001');$barrier=null;$args=array($case['request'],$case['deployment'],&$barrier);try{$deploy->invokeArgs($service,$args);throw new RuntimeException('Injected COMMIT fault was not observed.');}catch(Throwable $error){\AGSyncBridge\e2e_expect(false!==strpos($error->getMessage(),'commit'),'Unexpected fault error: '.$error->getMessage());}$state=$read_state->invoke($service);$outcome=$inspect->invoke($service,$state['receipt']['datasets'],true);\AGSyncBridge\e2e_expect($expected===$outcome['outcome'],'Commit fault recovery classified the real DB outcome incorrectly.');$wal_sha=V4MPG_Table_Deploy_Service::sha256($state);$lock_handle=is_array($barrier)?($barrier['lock_handle']??null):null;if(is_resource($lock_handle)){di_cache_epoch_close_lock($lock_handle);}unset($args,$barrier,$lock_handle);gc_collect_cycles();$adapter->commit_fault='none';$recovery=$service->recover(array('protocol'=>V4MPG_Table_Deploy_Service::PROTOCOL_VERSION,'operation_id'=>$case['request']['operation_id'],'expected_site'=>array('home_url'=>untrailingslashit(home_url()),'site_url'=>untrailingslashit(site_url()),'home_host'=>strtolower((string)wp_parse_url(home_url(),PHP_URL_HOST))),'state_sha256'=>$wal_sha,'action'=>'deployed'===$expected?'accept-deployed':'accept-rolled-back'));\AGSyncBridge\e2e_expect('recovered'===($recovery['status']??'')&&$expected===($recovery['outcome']??''),'Signed recovery did not close the exact fault outcome.');$final_state=$read_state->invoke($service);\AGSyncBridge\e2e_expect(!$ambiguous->invoke($service,(string)$final_state['status']),'Recovery left the WAL in an ambiguous state.');$e2e_results['fault_'.$fault]=array('status'=>'passed','expected_outcome'=>$expected,'observed_outcome'=>$outcome['outcome'],'wal_status'=>(string)$state['status'],'wal_sha256'=>$wal_sha,'recovery_receipt_sha256'=>V4MPG_Table_Deploy_Service::sha256($recovery),'final_status'=>(string)$final_state['status']);}
		$drop();$remaining=$wpdb->get_col($wpdb->prepare('SHOW TABLES LIKE %s',$test_prefix.'%'));\AGSyncBridge\e2e_expect(is_array($remaining)&&0===count($remaining),'E2E canary tables remained after cleanup verification.');$artifact_path=(string)getenv('AGSB_E2E_RECEIPT');if(''!==$artifact_path){$artifact=array('receipt_type'=>'agsync-v4mpg-real-wpdb-e2e','schema_version'=>1,'status'=>'passed','created_at'=>gmdate('c'),'wordpress_path'=>wp_normalize_path(ABSPATH),'service_sha256'=>hash_file('sha256',dirname(__DIR__).'/includes/class-v4mpg-table-deploy-service.php'),'harness_sha256'=>hash_file('sha256',__FILE__),'cases'=>$e2e_results,'canary_table_count_after_cleanup'=>count($remaining));$dir=dirname($artifact_path);if(!is_dir($dir)){wp_mkdir_p($dir);}$bytes=wp_json_encode($artifact,JSON_PRETTY_PRINT|JSON_UNESCAPED_SLASHES|JSON_UNESCAPED_UNICODE);if(false===file_put_contents($artifact_path,$bytes,LOCK_EX)){throw new RuntimeException('Unable to persist E2E receipt.');}echo 'e2e_receipt='.wp_normalize_path($artifact_path).' sha256='.hash_file('sha256',$artifact_path)."\n";}echo "v4mpg real WPDB E2E: ok\n";
	}finally{$drop();$wpdb->prefix=$original_prefix;if(is_file($storage.'/temp/v4mpg-table-operation.json')){@unlink($storage.'/temp/v4mpg-table-operation.json');}@rmdir($storage.'/temp');@rmdir($storage);}
}
